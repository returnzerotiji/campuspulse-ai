# Copy this file to .env and adjust values for your machine.

# --- App ---
APP_NAME=CampusPulse API
ENVIRONMENT=development
DEBUG=true

# --- CORS ---
# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Full Postgres URL used by SQLAlchemy. Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+psycopg2://campuspulse:campuspulse@localhost:5432/campuspulse

# --- AI ---
# Optional. Without it, classification/routing falls back to a deterministic
# keyword-based classifier so the app is fully functional with zero setup.
# Semantic similarity/duplicate detection always works offline (fastembed,
# no key needed).
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5

# --- Auth ---
# Change these before deploying anywhere real.
JWT_SECRET=dev-only-change-me
ADMIN_EMAIL=admin@campuspulse.local
ADMIN_PASSWORD=changeme123

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
